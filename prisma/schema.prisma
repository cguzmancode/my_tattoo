generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Artist {
  id              String        @id @default(uuid())
  clerkId         String        @unique
  email           String        @unique
  name            String
  slug            String        @unique
  bio             String?
  styles          String[]      @default([])
  depositAmount   Int           @default(2000)
  instagramUrl    String?
  portfolioImages String[]      @default([])
  isActive        Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  blockedDates    BlockedDate[]
  bookings        Booking[]

  @@map("artists")
}

model Booking {
  id               String        @id @default(uuid())
  artistId         String
  clientName       String
  clientEmail      String
  clientPhone      String?
  bodyZone         String
  size             String
  description      String
  referenceImages  String[]      @default([])
  preferredDates   String[]      @default([])
  status           BookingStatus @default(PENDING)
  proposedDate     DateTime?
  reminderSent24h  Boolean       @default(false)
  reminderSent48h  Boolean       @default(false)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  priceEstimate    Int?          @map("priceestimate")
  durationEstimate String?       @map("durationestimate")
  artistNotes      String?       @map("artistnotes")
  artist           Artist        @relation(fields: [artistId], references: [id], onDelete: Cascade)
  messages         BookingMessage[]

  @@map("bookings")
}

model BlockedDate {
  id        String   @id @default(uuid())
  artistId  String
  date      DateTime @db.Date
  reason    String?
  createdAt DateTime @default(now())
  artist    Artist   @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@unique([artistId, date])
  @@map("blocked_dates")
}

model BookingMessage {
  id        String   @id @default(cuid())
  bookingId String
  sender    String   // "client" | "artist"
  message   String
  createdAt DateTime @default(now())
  read      Boolean  @default(false)
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@map("booking_messages")
}

enum BookingStatus {
  PENDING
  ACCEPTED
  REJECTED
  CONFIRMED
  COMPLETED
  CANCELLED
}
